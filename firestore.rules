rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function emailDomain() {
      return request.auth.token.email.split('@')[1].lower();
    }
    // 許可するメールドメインをここに列挙してください（firebase-config.js の
    // window.__ALLOWED_DOMAINS と同じ内容にしてください）。
    // ブロック済み（退職者など）のメールアドレスは、Firestoreのレベルでも
    // 一切のアクセスを拒否します（blockedUsers コレクションのドキュメントID
    // は小文字化したメールアドレスです）。
    function isBlocked() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/blockedUsers/$(request.auth.token.email.lower()));
    }
    // 「スタッフ一覧」でGoogleアカウント（メールアドレス）が登録されている
    // 人だけにアクセスを許可します（staffEmails コレクションのドキュメントID
    // は小文字化したメールアドレスです）。
    function isRegisteredStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staffEmails/$(request.auth.token.email.lower()));
    }
    function isAllowedDomain() {
      return isSignedIn() && emailDomain() in ['5lance.co.jp'] && !isBlocked() && isRegisteredStaff();
    }
    // 管理者は "admins" コレクションに自分のUID（Firebase AuthのUID）の
    // ドキュメントを1つ作成すると付与されます。Firebaseコンソールの
    // Firestore画面から手動で追加してください（アプリの管理者パスワード画面に
    // 表示されるUIDをコピーして使えます）。
    function isAdmin() {
      return isAllowedDomain() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if isAllowedDomain();
      allow write: if false; // Firebaseコンソールから手動でのみ変更
    }

    // 実績記録：誰でも記録・自己修正（直前の取り消し）ができる
    match /events/{id} {
      allow read, create, update, delete: if isAllowedDomain();
    }

    // 社内向けリアルタイム通知（room機能の代替）
    match /roomEvents/{id} {
      allow read, create: if isAllowedDomain();
      allow update, delete: if false;
    }

    // マスタデータ：アプリ内の管理者パスワードで保護される想定のため、
    // Firestore側は社内ドメインの誰でも読み書きできるようにしています
    // （実際のアクセス制限はアプリの管理者パスワード画面で行っています。
    // これにより、ya.ishikawaさん以外の社員でもパスワードさえ知っていれば
    // スタッフ・シフト・お知らせの登録ができます）。
    match /staff/{id} { allow read, write: if isAllowedDomain(); }
    match /staffCompanies/{id} { allow read, write: if isAllowedDomain(); }
    // スタッフのGoogleアカウント一覧（アクセス許可の判定に使うミラー）。
    // ドキュメントIDは小文字化したメールアドレスです。ログイン時に「自分が
    // 登録されているか」を確認できるよう、自分自身のドキュメントだけは
    // 未登録の状態でも get できるようにしています（blockedUsers と同じ考え方）。
    match /staffEmails/{email} {
      allow get: if isSignedIn() && request.auth.token.email.lower() == email;
      allow read, write: if isAllowedDomain();
    }
    match /targets/{id} { allow read, write: if isAllowedDomain(); }
    match /notices/{id} { allow read, write: if isAllowedDomain(); }
    match /ashiftAgencies/{id} { allow read, write: if isAllowedDomain(); }
    match /ashiftBlocks/{id} { allow read, write: if isAllowedDomain(); }
    match /admin/{id} { allow read, write: if isAllowedDomain(); }
    match /dayoffRequests/{id} { allow read, write: if isAllowedDomain(); }
    match /weeklyReports/{id} { allow read, write: if isAllowedDomain(); }
    // お知らせの「確認しました」記録：誰が確認したか社内の誰でも見られます
    match /noticeReads/{id} { allow read, write: if isAllowedDomain(); }

    // アクセス権限（退職者など）：書き込み・一覧の読み取りは本物の管理者
    // （adminsコレクションに登録されたUID）のみ。各自は自分のメールアドレスの
    // ドキュメントだけ読めるので、ログイン時に自分がブロックされているか確認できます。
    match /blockedUsers/{email} {
      allow get: if isSignedIn() && request.auth.token.email.lower() == email;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // アクセスログ：誰でも自分のアクセス記録は作成・更新できますが、
    // 一覧の閲覧は本物の管理者のみです。記録前に「自分の記録が既にあるか」を
    // 確認する処理があるため、自分のドキュメント（ID末尾が自分のUID）だけは
    // 一覧権限がなくても get できるようにしています（blockedUsers と同じ考え方）。
    match /accessLogs/{id} {
      allow get: if isAllowedDomain() && id.matches('.*_' + request.auth.uid + '$');
      allow list: if isAdmin();
      allow create, update: if isAllowedDomain() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // その他の想定外のコレクションはデフォルトで拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
